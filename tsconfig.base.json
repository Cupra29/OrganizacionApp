{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "target": "es2024",
    "lib": ["es2024"],

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // No está en el manifiesto de fase-0-ejecucion.md §4.3, pero lo exige la
    // combinación que ese manifiesto eligió: `exports` apunta a ./src/index.ts,
    // así que los imports relativos llevan extensión .ts. Requiere noEmit.
    "allowImportingTsExtensions": true,

    "noEmit": true,
    "skipLibCheck": true
  }
}
